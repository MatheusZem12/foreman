# Copie para .env e ajuste. Tudo é opcional.

POSTGRES_PASSWORD=troque-esta-senha
MULTICA_PORT=8700
# 127.0.0.1 = só esta máquina; 0.0.0.0 = toda a rede (prefira VPN ou proxy com HTTPS)
MULTICA_BIND=127.0.0.1
MULTICA_MAX_PARALLEL=3
# true quando estiver atrás de HTTPS (proxy reverso)
MULTICA_SECURE_COOKIE=false

# Em vez de fazer login interativo nos CLIs, dá para usar chaves de API:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
