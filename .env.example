# Copy to .env and adjust. Everything is optional.

POSTGRES_PASSWORD=troque-esta-senha
FOREMAN_PORT=8700
# 127.0.0.1 = this machine only; 0.0.0.0 = the whole network (prefer a VPN or an HTTPS proxy)
FOREMAN_BIND=127.0.0.1
FOREMAN_MAX_PARALLEL=3
# true when behind HTTPS (reverse proxy)
FOREMAN_SECURE_COOKIE=false

# Instead of signing in to the CLIs interactively, you can use API keys:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
